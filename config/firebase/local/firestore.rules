rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(coupleId, userId) {
      return /databases/$(database)/documents/couples/$(coupleId)/members/$(userId);
    }

    function isCoupleMember(coupleId) {
      return signedIn() && exists(memberPath(coupleId, request.auth.uid));
    }

    function hasCurrentUserMemberId() {
      return signedIn()
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function isCreatingOwnCouple() {
      return hasCurrentUserMemberId();
    }

    function isJoiningCouple(coupleId) {
      return signedIn()
        && resource.data.memberIds is list
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && exists(/databases/$(database)/documents/coupleInvites/$(resource.data.inviteCode));
    }

    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if isCreatingOwnCouple();
      allow update: if isCoupleMember(coupleId) || isJoiningCouple(coupleId);
      allow delete: if false;

      match /members/{userId} {
        allow create: if signedIn() && request.auth.uid == userId;
        allow read: if isCoupleMember(coupleId)
          || (signedIn() && request.auth.uid == userId);
        allow update, delete: if isCoupleMember(coupleId)
          && request.auth.uid == userId;
      }

      match /{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }

    match /coupleInvites/{inviteCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.coupleId is string
        && (
          exists(/databases/$(database)/documents/couples/$(request.resource.data.coupleId))
          || getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.memberIds.hasAny([request.auth.uid])
        );
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
